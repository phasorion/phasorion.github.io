---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Phasorion" description="The requested Phasorion page could not be found." noindex>
  <section class="focus-section">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="section-title">Page not found</h1>
      <p class="body-copy">Please return to Home or explore our product families.</p>
      <a class="button" href="/">Back to Home</a>
      <a class="text-link" href="/products/">Explore Products →</a>
    </div>
  </section>
</BaseLayout>
