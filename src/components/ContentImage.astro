---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  diagram?: boolean;
  priority?: boolean;
}
const { src, alt, caption, diagram = false, priority = false } = Astro.props;
const widths = [480, 960, 1440].filter(width => width < src.width);
widths.push(src.width);
---
<figure class:list={['content-image', { 'content-image--diagram': diagram }]}>
  <Image src={src} alt={alt} widths={widths} sizes="(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 900px" format="webp" quality={85} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
